&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
    // Делаем так, чтобы код работал и из формы, и из списка
    МассивСчетов = Новый Массив;
    Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
        МассивСчетов = ПараметрКоманды;
    Иначе
        МассивСчетов.Добавить(ПараметрКоманды);
    КонецЕсли;

    Для Каждого СсылкаНаСчет Из МассивСчетов Цикл
        ТабДок = СформироватьСчетНаСервере(СсылкаНаСчет);
        ТабДок.Показать("Счет на оплату: " + Строка(СсылкаНаСчет));
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СформироватьСчетНаСервере(СсылкаНаСчет)
    ТабДок = Новый ТабличныйДокумент;
    ДокОбъект = СсылкаНаСчет.ПолучитьОбъект();

    // 1. Берем наш новый нарисованный макет
    Макет = ДокОбъект.ПолучитьМакет("МакетСчета");

    // 2. Получаем область, которую ты назвал "Шапка"
    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");

    // 3. Заполняем параметры из документа (всё, что в квадратных скобках)
    ОбластьШапка.Параметры.Заполнить(ДокОбъект);

    // 4. Выводим заполненный лист на экран
    ТабДок.Вывести(ОбластьШапка);

    // --- МАГИЯ QR-КОДА ---
    СтрокаQR = "ST00012|Name=" + ДокОбъект.НазваниеОрганизации + "|PersonalAcc=" + ДокОбъект.РасчетныйСчет + "|BankName=ПАО СБЕРБАНК|BIC=" + ДокОбъект.БИК + "|Sum=" + Формат(ДокОбъект.Сумма * 100, "ЧГ=0");
    
    // Рисуем штрихкод прямо в готовом документе
    РисунокQR = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Штрихкод);
    РисунокQR.ТипШтрихкода = ТипШтрихкода.QR;
    РисунокQR.ЗначениеШтрихкода = СтрокаQR;
    
    // Сажаем QR-код ровно в твой квадрат (строки 13-19, колонки 11-12)
    РисунокQR.Расположить(ТабДок.Область(13, 11, 19, 12));
    // ----------------------

    Возврат ТабДок;
КонецФункции
