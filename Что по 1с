&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
    // Команда передает нам массив выбранных счетов. Пробегаемся по ним.
    Для Каждого СсылкаНаСчет Из ПараметрКоманды Цикл
        // Просим сервер собрать нам печатную форму с QR-кодом
        ТабДок = СформироватьСчетНаСервере(СсылкаНаСчет);
        // Выводим готовую картинку на экран пользователю
        ТабДок.Показать("Счет на оплату: " + Строка(СсылкаНаСчет));
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СформироватьСчетНаСервере(СсылкаНаСчет)
    ТабДок = Новый ТабличныйДокумент;
    ДокОбъект = СсылкаНаСчет.ПолучитьОбъект();
    Макет = ДокОбъект.ПолучитьМакет("Печать");

    // Выводим заголовок
    ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
    ТабДок.Вывести(ОбластьЗаголовок);

    // Подготавливаем шапку с нашими реквизитами
    Шапка = Макет.ПолучитьОбласть("Шапка");
    Шапка.Параметры.Заполнить(ДокОбъект);

    // --- МАГИЯ QR-КОДА ЧЕРЕЗ API ---
    СтрокаQR = "ST00012|Name=" + ДокОбъект.НазваниеОрганизации + "|PersonalAcc=" + ДокОбъект.РасчетныйСчет + "|BankName=ПАО СБЕРБАНК|BIC=" + ДокОбъект.БИК + "|Sum=" + Формат(ДокОбъект.Сумма * 100, "ЧГ=0");
    СтрокаURL = КодироватьСтроку(СтрокаQR, СпособКодированияСтроки.URLВКодировкеURL);

    Соединение = Новый HTTPСоединение("api.qrserver.com", 443,,,,, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/v1/create-qr-code/?size=200x200&data=" + СтрокаURL);
    Ответ = Соединение.Получить(Запрос);

    Если Ответ.КодСостояния = 200 Тогда
        Шапка.Рисунки.РисунокQR.Картинка = Новый Картинка(Ответ.ПолучитьТелоКакДвоичныеДанные());
    Иначе
        Сообщить("Ошибка сети при генерации: " + Ответ.КодСостояния);
    КонецЕсли;
    // ---------------------------------

    ТабДок.Вывести(Шапка);
    Возврат ТабДок;
КонецФункции
