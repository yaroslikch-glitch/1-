&НаКлиенте
Процедура СчетНаОплату(Команда)
	ТабДок = СчетНаОплатуНаСервере();
	ТабДок.Показать("Печатная форма: Счет на оплату");
КонецПроцедуры

&НаСервере
Функция СчетНаОплатуНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ДокОбъект.ПолучитьМакет("МакетСчета");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	// Вывод текста в макет
	ОбластьШапка.Параметры.Заполнить(ДокОбъект);
	ОбластьШапка.Параметры.ЗаголовокСчета = "Счет на оплату № " + Число(ДокОбъект.Номер) + " от " + Формат(ДокОбъект.Дата, "ДФ=dd.MM.yyyy") + " г.";
	
	// --- ОФФЛАЙН ГЕНЕРАЦИЯ QR ИЗ ТВОИХ МАНУАЛОВ ---
	Попытка
		СтрокаQR = "ST00012|Name=" + ДокОбъект.НазваниеОрганизации + "|PersonalAcc=" + ДокОбъект.РасчетныйСчет + "|BankName=ПАО СБЕРБАНК|BIC=" + ДокОбъект.БИК + "|Sum=" + Формат(ДокОбъект.Сумма * 100, "ЧГ=0");
		Успешно = ПодключитьВнешнююКомпоненту("Документ.СчетНаОплату.Макет.КомпонентаQR", "MyBarcode", ТипВнешнейКомпоненты.Native);
		
		Если Успешно Тогда
			Генератор = Новый("AddIn.MyBarcode.Barcode");
			
			// Те самые свойства с твоих скриншотов!
			Генератор.ТипКода = 16; // 16 = <QR>
			Генератор.ЗначениеКода = СтрокаQR;
			
			ДвоичныеQR = Генератор.ПолучитьШтрихкод();
			
			Если ДвоичныеQR <> Неопределено Тогда
				РисунокQR = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
				РисунокQR.Картинка = Новый Картинка(ДвоичныеQR);
				РисунокQR.Расположить(ТабДок.Область(25, 10, 32, 12));
			Иначе
				Сообщить("Компонента не смогла сформировать картинку.");
			КонецЕсли;
		Иначе
			Сообщить("Не удалось подключить локальную компоненту.");
		КонецЕсли;
	Исключение
		Сообщить("Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	// ----------------------------------------------
	
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ТолькоПросмотр = Истина;
	
	Возврат ТабДок;
КонецФункции
