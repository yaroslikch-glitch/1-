&НаКлиенте
Процедура СчетНаОплату(Команда)
	ТабДок = СчетНаОплатуНаСервере();
	ТабДок.Показать("Печатная форма: Счет на оплату");
КонецПроцедуры

&НаСервере
Функция СформироватьСтрокуГОСТ(ДокОбъект)
	// Переводим сумму в копейки без копеечных хвостов
	СуммаВКопейках = Окр(ДокОбъект.Сумма * 100, 0);
	
	// Чистим названия от разделителя "|", чтобы не сломать стандарт
	ИмяПолучателя = СтрЗаменить(СокрЛП(ДокОбъект.НазваниеОрганизации), "|", " ");
	ИмяБанка      = СтрЗаменить(СокрЛП(ДокОбъект.НазваниеБанка), "|", " ");
	
	// Собираем базу
	Строка = "ST00012|";
	Строка = Строка + "Name=" + ИмяПолучателя + "|";
	Строка = Строка + "PersonalAcc=" + ДокОбъект.РасчетныйСчет + "|";
	Строка = Строка + "BankName=" + ИмяБанка + "|";
	Строка = Строка + "BIC=" + ДокОбъект.БИК + "|";
	
	// Проверь, как точно называется реквизит корр. счета в дереве!
	Строка = Строка + "CorrespAcc=" + ДокОбъект.КорреспондентскийСчет + "|"; 
	Строка = Строка + "PayeeINN=" + ДокОбъект.ИНН + "|";
	
	// Добавляем КПП, если он заполнен
	Если Не ПустаяСтрока(ДокОбъект.КПП) Тогда
		Строка = Строка + "KPP=" + ДокОбъект.КПП + "|";
	КонецЕсли;
	
	Строка = Строка + "Sum=" + Формат(СуммаВКопейках, "ЧГ=0") + "|";
	
	// Красивое назначение платежа
	Назначение = "Оплата по счету № " + Число(ДокОбъект.Номер) + " от " + Формат(ДокОбъект.Дата, "ДФ=dd.MM.yyyy");
	Строка = Строка + "Purpose=" + Назначение;
	
	Возврат Строка;
КонецФункции

&НаСервере
Функция СчетНаОплатуНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ДокОбъект.ПолучитьМакет("МакетСчета");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	// Вывод текста в макет
	ОбластьШапка.Параметры.Заполнить(ДокОбъект);
	ОбластьШапка.Параметры.ЗаголовокСчета = "Счет на оплату № " + Число(ДокОбъект.Номер) + " от " + Формат(ДокОбъект.Дата, "ДФ=dd.MM.yyyy") + " г.";
	
	Попытка
		СтрокаQR = СформироватьСтрокуГОСТ(ДокОбъект);
		
		// --- ТОТ САМЫЙ ЛАЙФХАК С ТВОЕГО СКРИНШОТА ---
		// Достаем архив из макета в виде сырых данных
		МакетКомпоненты = ДокОбъект.ПолучитьМакет("КомпонентаQR");
		// Закидываем его в оперативную память (временное хранилище)
		АдресВПамяти = ПоместитьВоВременноеХранилище(МакетКомпоненты);
		
		// Подключаем библиотеку прямо из оперативной памяти!
		Успешно = ПодключитьВнешнююКомпоненту(АдресВПамяти, "MyBarcode", ТипВнешнейКомпоненты.Native);
		// ----------------------------------------------
		
		Если Успешно Тогда
			Генератор = Новый("AddIn.MyBarcode.Barcode");
			
			Генератор.ТипКода = 16; 
			Генератор.ЗначениеКода = СтрокаQR;
			
			ДвоичныеQR = Генератор.ПолучитьШтрихкод();
			
			Если ДвоичныеQR <> Неопределено Тогда
				РисунокQR = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
				РисунокQR.Картинка = Новый Картинка(ДвоичныеQR);
				РисунокQR.Расположить(ТабДок.Область(28, 10, 34, 12));
			Иначе
				Сообщить("Компонента загрузилась, но не смогла нарисовать картинку.");
			КонецЕсли;
		Иначе
			Сообщить("Библиотека QR отклонена системой безопасности ПК или 1С.");
		КонецЕсли;
	Исключение
		Сообщить("Ошибка QR: " + ОписаниеОшибки());
	КонецПопытки;
	
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ТолькоПросмотр = Истина;
	
	Возврат ТабДок;
КонецФункции
