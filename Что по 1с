&НаКлиенте
Процедура СчетНаОплату(Команда)
    // Стучимся на сервер, просим собрать бумажку
    ТабДок = СчетНаОплатуНаСервере();
    // Показываем готовый результат на экране
    ТабДок.Показать("Печатная форма: Счет на оплату");
КонецПроцедуры

&НаСервере
Функция СчетНаОплатуНаСервере()
    // Создаем пустой белый лист
    ТабДок = Новый ТабличныйДокумент;

    // Достаем макет из нашего документа
    ДокОбъект = РеквизитФормыВЗначение("Объект");
    Макет = ДокОбъект.ПолучитьМакет("МакетСчета");

    // Хватаем ту самую область, которую ты назвал "Шапка"
    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");

    // Магия 1С: заполняем параметры из документа (твои шаблоны в ячейках)
    ОбластьШапка.Параметры.Заполнить(Объект);

    // Выводим лист на экран
    ТабДок.Вывести(ОбластьШапка);

    Возврат ТабДок;
КонецФункции
